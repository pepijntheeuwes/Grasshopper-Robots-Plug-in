, 94, 93, 93, 93, 94, 94, 94, 93, 93, 93, 94, 94, 94, 94, 94, 94, 95, 95, 95, 94, 94, 94, 95, 95, 95, 94, 94, 94, 95, 95, 95, 96, 96, 96, 95, 95, 95, 94, 94, 94, 95, 95, 95, 95, 95, 95, 95, 95, 95, 96, 96, 96, 97, 97, 97, 96, 96, 96, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 98, 98, 98, 96, 96, 96, 94, 94, 94, 94, 94, 94, 93, 93, 93, 93, 93, 93, 92, 92, 92, 93, 93, 93, 92, 92, 92, 91, 91, 91, 89, 89, 89, 88, 88, 88, 86, 86, 86, 86, 86, 86, 86, 86, 86, 85, 85, 85, 83, 83, 83, 81, 81, 81, 80, 80, 80, 79, 79, 79, 77, 77, 77, 78, 78, 78, 77, 77, 77, 75, 75, 75, 72, 72, 72, 72, 72, 72, 71, 71, 71, 70, 70, 70, 68, 68, 68, 67, 67, 67, 68, 68, 68, 65, 65, 65, 63, 63, 63, 61, 61, 61, 60, 60, 60, 59, 59, 59, 59, 59, 59, 58, 58, 58, 53, 53, 53, 54, 54, 54, 51, 51, 51, 51, 51, 51, 45, 45, 45, 45, 45, 45, 25, 25, 25, 23, 23, 23, 23, 23, 23, 21, 21, 21, 22, 22, 22, 21, 21, 21, 19, 19, 19, 19, 19, 19, 17, 17, 17, 17, 17, 17, 15, 15, 15, 15, 15, 15, 14, 14, 14, 13, 13, 13, 12, 12, 12, 11, 11, 11, 11, 11, 11, 9, 9, 9, 8, 8, 8, 7, 7, 7, 5, 5, 5, 3, 3, 3]
    global g = 300
    global lt = 0.2
    global time = 0.12
    global levelpoint = [1.378203,-1.222039,1.676481,0.3369984,1.436868,3.00275]

    global extrusion_trigger = False
    global thread_val_E = 0
    global thread_val_F = 0 
    global target_pose = [0,0,0,0,0,0]
    global raw_data = [0,0,0,0,0,0,0,0,0]
    global rest_pose = [1.57, -1.57, 1.57, 0, 1.57, 3.14]

    def fetch_next_pose():
        socket_send_string("NEXT", "laptop_socket")
        # We now expect 8 floats: [jointpose, height, distance]
        data = socket_read_ascii_float(8, "laptop_socket")
        textmsg("laptop data = ",data)
        return data
    end

    raw_data = fetch_next_pose()
    if raw_data[0] < 8:
        popup("Error: Could not fetch initial waypoint", "Error", error=True)
        halt
    end

    target_pose = [raw_data[1], raw_data[2], raw_data[3], raw_data[4], raw_data[5], raw_data[6]]

    thread ExtruderControl():
        while True:
            if extrusion_trigger == True:
                gcode_line = str_cat("G1 E", str_cat(thread_val_E, str_cat(" F", thread_val_F)))
                socket_send_line(gcode_line, "duet_socket")
                extrusion_trigger = False
                textmsg(gcode_line, " sent")
            end
            sync()
        end
    end

    ext_thread_handle = run ExtruderControl()

    # Bed levelling
    movel(target_pose, a=1.0, v=0.1)
    popup("Use nozzle as reference to level printbed and press CONTINUE to move on to the next corner.", "Level printbed", blocking=True)
    movel(levelpoint, a=1.0, v=0.1)
    popup("Use nozzle as reference to level printbed and press CONTINUE to move on to the next corner.", "Level printbed", blocking=True)
    movel(target_pose, a=1.0, v=0.1)
    popup("Use nozzle as reference to level printbed and press CONTINUE to move on to the next corner.", "Level printbed", blocking=True)
    movel(levelpoint, a=1.0, v=0.1)
    popup("Use nozzle as reference to level printbed and press CONTINUE to move on to the next corner.", "Level printbed", blocking=True)

    # Heating
    movej(rest_pose, a=1, v=0.3, r=0)
    socket_send_line("M104 S200", "duet_socket")
    socket_send_line("M190 S60", "duet_socket")
    socket_send_line("G1 E30 F300", "duet_socket")
    
    layer_idx = 0
    pose_pointer = 0
    num_layers = length(poses_per_layer)

    popup("If Nozzle is primed press CONTINUE to move to the start position", "Start", blocking=True)
    movej(target_pose, a=1.0, v=0.1)

    keep_printing = True

    # total_layers = length(poses_per_layer)
    # milestone_25 = floor(total_layers * 0.25)
    # milestone_50 = floor(total_layers * 0.50)
    # milestone_75 = floor(total_layers * 0.75)
    
    while keep_printing:
        while layer_idx < num_layers:
            poses_in_this_layer = poses_per_layer[layer_idx]
            i = 0

            if (layer_idx == 2):
                socket_send_line("M106 S255", "duet_socket")
                # sync()
            end

            # if (layer_idx == milestone_25) or (layer_idx == milestone_50) or (layer_idx == milestone_75):
            #     # Ensure we only pause once per milestone layer
            #     if i == 0:                   
            #         movej(rest_pose, a=1, v=0.3, r=0)
            #         popup("Take a picture.", "Milestone Pause", blocking=True)
            #         movej(target_pose, a=1.0, v=0.1)
            #     end
            # end

            while i < poses_in_this_layer:
                raw_data = fetch_next_pose()
                if raw_data[0] >= 6:
                    target_pose = [raw_data[1], raw_data[2], raw_data[3], raw_data[4], raw_data[5], raw_data[6]]
                    
                    dist = raw_data[8]

                    if layer_idx == 0:
                        h = raw_data[7]*1.1
                    else:
                        h = raw_data[7]
                    end

                    thread_val_E = (0.4 * h * dist)/2.405
                    thread_val_F = (thread_val_E / time) * 60
                    extrusion_trigger = True

                    servoj(target_pose, t=time, lookahead_time=lt, gain=g)

                else:
                    textmsg("Warning: Failed to receive pose at pointer ", pose_pointer)
                    keep_printing = False
                    sync()
                end

                pose_pointer = pose_pointer + 1
                i = i + 1
                
            end
            layer_idx = layer_idx + 1
        end 
        
    end

    kill ext_thread_handle 
    socket_send_line("M104 S0", "duet_socket")
    socket_send_line("M140 S0", "duet_socket")
    socket_send_line("M107", "duet_socket")

    movej(rest_pose, a=1, v=0.3, r=0)
    textmsg("Program finished and thread killed -> turn off heaters.")
    socket_close("duet_socket")
end
extrusion_program()
    